# WeatherGPT SIH 26068
DEMO_MODE=true
APP_ENV=development
SECRET_KEY=change-me-in-production-weathergpt-sih-26068
DATABASE_URL=postgresql+psycopg2://weathergpt:weathergpt@localhost:5432/weathergpt
# Local SQLite fallback (used if you do not start Postgres):
# DATABASE_URL=sqlite:///./weathergpt.db

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Weather: open_meteo (live, no key) or demo
WEATHER_PROVIDER=open_meteo
WEATHER_API_KEY=
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1
WEATHER_GEOCODE_URL=https://geocoding-api.open-meteo.com/v1/search
WEATHER_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive

# LLM (leave empty to use grounded template DemoLLM)
LLM_PROVIDER=openai_compat
LLM_API_KEY=
LLM_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

DEMO_OTP=123456
OTP_EXPIRE_MINUTES=10
WEATHER_CACHE_TTL_SECONDS=600
RATE_LIMIT=60/minute
LOG_LEVEL=INFO

VITE_API_URL=http://localhost:8000
